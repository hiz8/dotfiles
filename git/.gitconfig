[alias]
	tree = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	cleanup = !git branch --merged | grep -vE \"^[*+]|^\\s*(main|master|develop)$\" | xargs -r -n 1 git branch -d
	pushf = push --force-with-lease
[user]
	# name / email はマシンごとに ~/.gitconfig.local で設定する。
	# 未設定のときは推測値を使わず、コミットを止める。
	useConfigOnly = true
[core]
	editor = vim
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[pull]
	rebase = true

# マシン固有の設定（user、url.insteadOf など）。後に読む値が優先されるため末尾に置く。
# ファイルがなければ無視される。
[include]
	path = ~/.gitconfig.local
